bash -c date\ -u\;\ uname\ -a\;\ x86_64-w64-mingw32-gcc\ --version\;\ wine\ --version\;\ venv/bin/pip\ freeze\;\ dpkg-query\ -W\ mesa-vulkan-drivers\ libvulkan1\ mingw-w64-x86-64-dev\ bison\ flex\ glslang-tools\;\ git\ -C\ src/DirectX-Headers\ log\ -1\ --format=fuller\;\ sha256sum\ runtime/d3d12\*.dll\;\ ls\ -l\ /tmp/.X11-unix/X93 
