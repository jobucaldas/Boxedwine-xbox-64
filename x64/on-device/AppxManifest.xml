<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap rescap">
  <Identity Name="Joao.Boxedwine.DevMode" Publisher="CN=BoxedwineDev" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Boxedwine Dev Mode</DisplayName>
    <PublisherDisplayName>Joao</PublisherDisplayName>
    <Logo>Assets/StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.14393.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>
  <Resources><Resource Language="en-us" /></Resources>
  <!-- Native CoreApplication probe entry; console activation is unverified.
       Game/Title memory: select Game in Developer Home for the intended title
       memory budget; do not assume the desktop smoke process measures it. -->
  <Applications>
    <Application Id="App" Executable="rungs.exe" EntryPoint="Boxedwine.App">
      <uap:VisualElements DisplayName="Boxedwine Dev Mode" Description="In-process Wine runtime skeleton"
                          BackgroundColor="transparent" Square150x150Logo="Assets/Logo.png"
                          Square44x44Logo="Assets/SmallLogo.png" />
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="bwlog">
            <uap:SupportedFileTypes><uap:FileType>.bwlog</uap:FileType></uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
    <!-- Explicit destructive-storage opt-in; Load receives this EntryPoint. -->
    <Application Id="BigFile" Executable="rungs.exe" EntryPoint="Boxedwine.BigFile">
      <uap:VisualElements DisplayName="Boxedwine Big file opt-in" Description="Enable --big-file: write/read/delete 2304 MiB in LocalState"
                          BackgroundColor="transparent" Square150x150Logo="Assets/Logo.png"
                          Square44x44Logo="Assets/SmallLogo.png" />
    </Application>
    <Application Id="PickFolder" Executable="rungs.exe" EntryPoint="Boxedwine.PickFolder">
      <uap:VisualElements DisplayName="Boxedwine Pick USB folder" Description="Write/read/delete 64 MiB in a picked folder"
                          BackgroundColor="transparent" Square150x150Logo="Assets/Logo.png"
                          Square44x44Logo="Assets/SmallLogo.png" />
    </Application>
    <Application Id="PickFolderBigFile" Executable="rungs.exe" EntryPoint="Boxedwine.PickFolderBigFile">
      <uap:VisualElements DisplayName="Boxedwine USB big file opt-in" Description="Enable --big-file: 64 MiB then 2304 MiB in a picked folder"
                          BackgroundColor="transparent" Square150x150Logo="Assets/Logo.png"
                          Square44x44Logo="Assets/SmallLogo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <Capability Name="codeGeneration" />
    <!-- Needs the .bwlog fileTypeAssociation on App. -->
    <uap:Capability Name="removableStorage" />
    <!-- Dev sideload only: deprecated and Store-rejected. -->
    <rescap:Capability Name="expandedResources"/>
  </Capabilities>
</Package>
