+/* WINE_INPROC_DESKTOP=1 in the process environment, read exactly once. */
+static pthread_once_t inproc_desktop_once = PTHREAD_ONCE_INIT;
+static BOOL inproc_desktop_enabled;
+
+static void init_inproc_desktop(void)
+{
+    const char *env = getenv( "WINE_INPROC_DESKTOP" );
+    inproc_desktop_enabled = env && !strcmp( env, "1" );
+}
+
+static BOOL use_inproc_desktop(void)
+{
+    pthread_once( &inproc_desktop_once, init_inproc_desktop );
+    return inproc_desktop_enabled;
+}
+
+/* start the desktop as a thread of this process, then query it like the explorer path */
+static void start_inproc_desktop( struct ntuser_thread_info *thread_info )
+{
+    struct user_thread_info *info = get_user_thread_info();
+    void *ret_ptr;
+    ULONG ret_len;
+    NTSTATUS status;
+
+    /* loading the desktop DLL may look up the desktop again on this thread */
+    if (info->inproc_desktop_start) return;
+    info->inproc_desktop_start = TRUE;
+    /* concurrent first callers all wait inside uwp_desktop_start for the one owner */
+    status = KeUserModeCallback( NtUserStartInprocDesktop, NULL, 0, &ret_ptr, &ret_len );
+    info->inproc_desktop_start = FALSE;
+    /* the desktop thread itself, before its desktop window exists: forcing would
+     * create a bare server desktop in place of the real one */
+    if (status == STATUS_POSSIBLE_DEADLOCK) return;
+    if (status) ERR_(win)( "failed to start in-process desktop %x\n", status );
+    else TRACE_(win)( "started in-process desktop\n" );
+
+    SERVER_START_REQ( get_desktop_window )
+    {
+        req->force = 1;
+        if (!wine_server_call( req ))
+        {
+            thread_info->top_window = reply->top_window;
+            thread_info->msg_window = reply->msg_window;
+        }
+    }
+    SERVER_END_REQ;
+}
