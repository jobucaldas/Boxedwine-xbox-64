+/* Start the desktop as a thread of this process instead of an explorer process. */
+static NTSTATUS WINAPI User32StartInprocDesktop( void *args, ULONG size )
+{
+    NTSTATUS (WINAPI *start)( DWORD );
+    HMODULE module;
+    NTSTATUS status;
+
+    if (!(module = LoadLibraryW( L"uwpdesktop.dll" )))
+    {
+        ERR( "failed to load uwpdesktop.dll, error %lu\n", GetLastError() );
+        return STATUS_DLL_NOT_FOUND;
+    }
+    if (!(start = (void *)GetProcAddress( module, "uwp_desktop_start" )))
+    {
+        ERR( "uwp_desktop_start not found in uwpdesktop.dll\n" );
+        return STATUS_ENTRYPOINT_NOT_FOUND;
+    }
+    status = start( 10000 );
+    /* The desktop thread's own early lookups are expected to bail out. */
+    if (status && status != STATUS_POSSIBLE_DEADLOCK)
+        ERR( "failed to start in-process desktop, status %#lx\n", status );
+    return status;
+}
