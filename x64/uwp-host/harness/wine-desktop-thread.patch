+
+void manage_desktop( WCHAR *arg )
+{
+    desktop_run( arg, NULL );
+}
+
+static LONG desktop_owner;
+static HANDLE desktop_ready;
+
+static DWORD WINAPI desktop_thread( void *arg )
+{
+    WCHAR options[] = L"";
+    NTSTATUS status = desktop_run( options, arg );
+    if (status)
+    {
+        desktop_status = status;
+        SetEvent( arg );
+    }
+    ExitThread( status );
+    return status;
+}
+
+NTSTATUS WINAPI uwp_desktop_start( DWORD timeout_ms )
+{
+    ULONGLONG start = GetTickCount64(), elapsed;
+    HANDLE thread;
+    DWORD wait;
+
+    if (!InterlockedCompareExchange( &desktop_owner, 1, 0 ))
+    {
+        desktop_status = STATUS_UNSUCCESSFUL;
+        desktop_ready = CreateEventW( NULL, TRUE, FALSE, NULL );
+        if (desktop_ready)
+        {
+            thread = CreateThread( NULL, 0, desktop_thread, desktop_ready, 0, NULL );
+            if (thread) CloseHandle( thread );
+            else SetEvent( desktop_ready );
+        }
+        InterlockedExchange( &desktop_owner, 2 );
+    }
+    /* Publish the one event only after creation, including failure. */
+    while (InterlockedCompareExchange( &desktop_owner, 2, 2 ) != 2)
+    {
+        if (GetTickCount64() - start >= timeout_ms) return STATUS_TIMEOUT;
+        Sleep( 1 );
+    }
+    if (!desktop_ready) return desktop_status;
+    elapsed = GetTickCount64() - start;
+    wait = WaitForSingleObject( desktop_ready, elapsed >= timeout_ms ? 0 : timeout_ms - elapsed );
+    if (wait == WAIT_TIMEOUT) return STATUS_TIMEOUT;
+    if (wait != WAIT_OBJECT_0) return STATUS_UNSUCCESSFUL;
+    return desktop_status;
 }
 
